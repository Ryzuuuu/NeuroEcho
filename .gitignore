# Python bytecode and caches
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
env/
ENV/

# Packaging and build artifacts
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Machine learning and model files
*.pt
*.pth
*.pkl
*.joblib
*.onnx
*.bin
*.h5
*.ckpt

# Data and models (only the small UCI dataset and the lightweight biomarker
# model are tracked so the project runs straight after cloning)
ml/data/raw/*
ml/data/processed/*
!ml/data/raw/.gitkeep
!ml/data/raw/parkinsons.data
!ml/data/processed/.gitkeep
ml/models/*
!ml/models/.gitkeep
!ml/models/biomarker_model.pkl
!ml/models/shap_summary.png

# Audio recordings (may contain personal voice data)
*.wav

# Local uploads, temporary files, and logs
backend/debug_uploads/
uploads/
tmp/
temp/
*.log
*_log.txt
*.tmp
*.swp

